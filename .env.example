# Email API Configuration (Amazon SES SMTP)
# Copy this file to .env and fill in your actual values

# SMTP Server Settings — Amazon SES / Mail Manager
# From AWS console: SES → SMTP settings (or Mail Manager ingress endpoint)
SMTP_HOST=tftz737gwpnj.zevm.mail-manager-smtp.amazonaws.com
# Mail Manager authenticated ingress supports 25 and 587 (STARTTLS). Prefer 587.
SMTP_PORT=587
SMTP_USER=inp-your-smtp-username
# Password from the AWS SMTP credentials CSV (shown only once). Quote if it contains special chars.
SMTP_PASSWORD="your-ses-smtp-password"
SMTP_SECURE=false

# Email Sender Settings
# Must be a verified identity/domain in Amazon SES
FROM_EMAIL=admin@yourdomain.com
FROM_NAME=Sympos-ia Committee

# Email API Server Port (optional, default: 3001)
EMAIL_SERVER_PORT=3001

# Frontend URL for CORS (optional, default: http://localhost:3000)
VITE_APP_URL=http://localhost:3000

# Email API URL
# Local dev: http://localhost:3001 (the Node server from `npm run email-server`)
# Hosted (Amplify / www.symposai.pro): leave UNSET.
# Do NOT set this to the Amplify *.amplifyapp.com URL — that causes CORS errors
# when users open the custom domain. Hosted mail uses Supabase `send-email`.
VITE_EMAIL_API_URL=http://localhost:3001

# Supabase Configuration (if still using Supabase for other features)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: required for organizer-created participant accounts (auto-confirmed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Other API Keys (if needed)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI — AI Poster Manager (server/ai-poster-api.js)
OPENAI_API_KEY=your-openai-api-key
# Optional: gpt-image-1 (default) or dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-1
AI_POSTER_SERVER_PORT=3007
# Optional frontend override (defaults to http://localhost:3007)
# VITE_AI_POSTER_API_URL=http://localhost:3007
