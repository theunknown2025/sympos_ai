{
  "name": "sympose-ai---organizer-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:preview": "vite build && vite preview",
    "json-server": "json-server --watch db.json --port 3000",
    "email-server": "node server/email-api.js",
    "email-server:test": "node scripts/test-smtp.mjs",
    "latex-server": "node server/latex-compilation-api.js",
    "admin-display-server": "node server/admin-display-config-api.js",
    "performance-server": "node server/performance-test-api.js",
    "security-server": "node server/security-scan-api.js",
    "ai-poster-server": "node server/ai-poster-api.js",
    "security:run": "node security/scripts/run-check.mjs headers",
    "security:run:all": "node security/scripts/run-all-checks.mjs",
    "security:install-zap": "powershell -ExecutionPolicy Bypass -File security/scripts/install-zap.ps1",
    "security:log": "node security/scripts/generate-security-log.mjs",
    "dev:all": "npm run jmeter:install && concurrently -n vite,email,latex,admin,perf,sec,aiposter \"npm run dev\" \"npm run email-server\" \"npm run latex-server\" \"npm run admin-display-server\" \"npm run performance-server\" \"npm run security-server\" \"npm run ai-poster-server\"",
    "jmeter:install": "powershell -ExecutionPolicy Bypass -File jmeter/scripts/install-jmeter.ps1",
    "jmeter:dev": "node jmeter/scripts/wait-and-run.mjs",
    "jmeter:generate": "node jmeter/scripts/generate-test-plans.mjs",
    "jmeter:run": "powershell -ExecutionPolicy Bypass -File jmeter/scripts/run-section.ps1",
    "jmeter:run:all": "powershell -ExecutionPolicy Bypass -File jmeter/scripts/run-all.ps1",
    "jmeter:stress": "powershell -ExecutionPolicy Bypass -File jmeter/scripts/run-stress-section.ps1",
    "jmeter:stress:all": "powershell -ExecutionPolicy Bypass -File jmeter/scripts/run-stress-all.ps1",
    "postinstall": "npm run jmeter:install"
  },
  "dependencies": {
    "@duyank/icons": "^0.1.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "1.33.0",
    "@mui/material": "^6.4.5",
    "@supabase/supabase-js": "^2.89.0",
    "@uiw/react-codemirror": "^4.25.4",
    "axios": "^1.7.9",
    "codemirror": "^6.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jsqr": "^1.4.0",
    "katex": "^0.16.27",
    "konva": "^10.0.12",
    "latex.js": "^0.12.6",
    "lodash": "^4.17.21",
    "lucide-react": "0.469.0",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "quill": "^2.0.3",
    "react": "^19.2.4",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.4",
    "react-katex": "^3.1.0",
    "react-konva": "^19.2.1",
    "react-latex": "^2.0.0",
    "react-quill": "^2.0.0",
    "react-responsive-masonry": "^2.7.1",
    "react-router-dom": "^7.11.0",
    "react-use": "^17.6.0",
    "recharts": "2.15.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "json-server": "^0.17.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
